        <item name="postSplashScreenTheme">@style/Theme.Scribe</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/splash_bg_midnight</item>
        <item name="android:navigationBarColor">@color/splash_bg_midnight</item>
    </style>

