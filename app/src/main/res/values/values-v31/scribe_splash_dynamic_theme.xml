<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        API 31+ version of splash styles.
        Identical to values/scribe_splash_dynamic_theme.xml but adds
        windowSplashScreenAnimatedIconForegroundColor which is only
        available as a platform attribute on Android 12+.
        Place this file at: res/values-v31/scribe_splash_dynamic_theme.xml
    -->

    <style name="Theme.Scribe.Splash.Obsidian" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg_obsidian</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/scribe_splash_mark_vector</item>
        <item name="windowSplashScreenAnimatedIconForegroundColor">@color/splash_icon_obsidian</item>
        <item name="postSplashScreenTheme">@style/Theme.Scribe</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/splash_bg_obsidian</item>
        <item name="android:navigationBarColor">@color/splash_bg_obsidian</item>
    </style>

    <style name="Theme.Scribe.Splash.Midnight" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg_midnight</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/scribe_splash_mark_vector</item>
